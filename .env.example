# Copy this file to .env and adjust values for your setup.
SECRET_KEY=replace-with-a-random-local-value
SERIAL_PORT=COM3
SERIAL_BAUD_RATE=9600
SERIAL_RETRY_SECONDS=5
WEATHER_TIMEOUT_SECONDS=8
INGEST_TOKEN=replace-with-a-long-random-token
# Cloud bridge only: HTTPS URL of your deployed Render website.
# RENDER_URL=https://your-service.onrender.com
# BRIDGE_HTTP_TIMEOUT_SECONDS=10
# Optional. By default the database is stored in data\environment.db.
# DATABASE_PATH=C:\path\to\environment.db
