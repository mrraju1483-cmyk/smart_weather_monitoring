import pandas as pd
import matplotlib.pyplot as plt
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA

# =========================================================
# 1. Load the Housing dataset
# =========================================================

data = pd.read_csv(r"E:\3ds_ml\lab\housing.csv")

print("First five records:")
print(data.head())

print("\nDataset shape:")
print(data.shape)


# =========================================================
# 2. Separate target variable from input variables
# =========================================================
# Price is kept separately and is NOT used in PCA.

y = data["price"]
X = data.drop("price", axis=1)


# =========================================================
# 3. Convert categorical variables into numerical values
# =========================================================

yes_no = [
    "mainroad",
    "guestroom",
    "basement",
    "hotwaterheating",
    "airconditioning",
    "prefarea"
]

for col in yes_no:
    X[col] = X[col].map({
        "yes": 1,
        "no": 0
    })

# Convert furnishing status into dummy variables
X = pd.get_dummies(
    X,
    columns=["furnishingstatus"],
    drop_first=True,
    dtype=int
)

print("\nVariables used for PCA:")
print(X.columns.tolist())


# =========================================================
# 4. Standardize the input variables
# =========================================================
# Standardization puts all variables on a comparable scale.

scaler = StandardScaler()

X_scaled = scaler.fit_transform(X)


# =========================================================
# 5. Apply Principal Component Analysis
# =========================================================

pca = PCA()

X_pca = pca.fit_transform(X_scaled)


# =========================================================
# 6. Calculate explained variance
# =========================================================

explained = pca.explained_variance_ratio_ * 100

cumulative = explained.cumsum()

results = pd.DataFrame({
    "Principal Component":
        [f"PC{i+1}" for i in range(len(explained))],

    "Explained Variance (%)":
        explained,

    "Cumulative Variance (%)":
        cumulative
})

print("\nPCA Results:")
print(results.round(2))


# =========================================================
# 7. Find components required for 90% variance
# =========================================================

components_90 = (
    cumulative >= 90
).argmax() + 1

print(
    f"\nNumber of components required "
    f"to explain 90% variance: {components_90}"
)


# =========================================================
# 8. Scree Plot
# =========================================================

plt.figure(figsize=(8, 5))

plt.plot(
    range(1, len(explained) + 1),
    explained,
    marker="o",
    linewidth=2,
    color="blue"
)

plt.xlabel("Principal Component")
plt.ylabel("Explained Variance (%)")
plt.title("Scree Plot - Housing Dataset")

plt.xticks(
    range(1, len(explained) + 1)
)

plt.grid(
    True,
    linestyle="--",
    alpha=0.5
)

plt.tight_layout()
plt.show()


# =========================================================
# 9. Cumulative Explained Variance Plot
# =========================================================

plt.figure(figsize=(8, 5))

plt.plot(
    range(1, len(cumulative) + 1),
    cumulative,
    marker="o",
    linewidth=2,
    color="green"
)

plt.axhline(
    90,
    color="red",
    linestyle="--",
    label="90% variance"
)

plt.axvline(
    components_90,
    color="red",
    linestyle=":",
    label=f"{components_90} components"
)

plt.xlabel("Number of Principal Components")
plt.ylabel("Cumulative Variance (%)")
plt.title("Cumulative Explained Variance")

plt.xticks(
    range(1, len(cumulative) + 1)
)

plt.ylim(0, 105)

plt.legend()

plt.grid(
    True,
    linestyle="--",
    alpha=0.5
)

plt.tight_layout()
plt.show()


# =========================================================
# 10. PCA Score Plot: PC1 vs PC2
# =========================================================
# Price is used ONLY for colour visualization.
# It does not affect the PCA calculation.

plt.figure(figsize=(8, 6))

scatter = plt.scatter(
    X_pca[:, 0],
    X_pca[:, 1],
    c=y,
    cmap="viridis",
    alpha=0.7
)

plt.xlabel(
    f"PC1 ({explained[0]:.2f}% variance)"
)

plt.ylabel(
    f"PC2 ({explained[1]:.2f}% variance)"
)

plt.title("PCA Score Plot: PC1 vs PC2")

plt.colorbar(
    scatter,
    label="House Price"
)

plt.grid(
    True,
    linestyle="--",
    alpha=0.5
)

plt.tight_layout()
plt.show()


# =========================================================
# 11. PCA Loadings
# =========================================================
# Loadings show the contribution of each original variable
# to the principal components.

loadings = pd.DataFrame(
    pca.components_.T,
    index=X.columns,
    columns=[
        f"PC{i+1}"
        for i in range(X.shape[1])
    ]
)

print("\nPCA Loadings:")
print(loadings.round(3))


# =========================================================
# 12. PC1 Loading Plot
# =========================================================

plt.figure(figsize=(9, 6))

loadings["PC1"].sort_values().plot(
    kind="barh",
    color="steelblue"
)

plt.axvline(
    0,
    color="black",
    linewidth=1
)

plt.xlabel("PC1 Loading")
plt.ylabel("Variable")
plt.title("PC1 Loadings")

plt.grid(
    axis="x",
    linestyle="--",
    alpha=0.5
)

plt.tight_layout()
plt.show()


# =========================================================
# End of PCA Experiment
# =========================================================
